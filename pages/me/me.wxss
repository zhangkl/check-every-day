.profile {
  display: flex;
  align-items: center;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  background: #fdf3e8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.profile .muted {
  margin-top: 8rpx;
}

.stats {
  display: flex;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 26rpx 8rpx;
  margin: 0 8rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(200, 170, 140, 0.1);
}

.stat-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #4a4038;
}

.stat-item .tiny {
  margin-top: 8rpx;
}

.menu {
  padding: 8rpx 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #faf5ee;
}

.menu-item:last-child {
  border-bottom: none;
}

.mi-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.mi-arrow {
  color: #cfc2b4;
  font-size: 34rpx;
  margin-left: 8rpx;
}

.mi-badge {
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #e4736b;
  color: #fff;
  font-size: 22rpx;
  padding: 0 10rpx;
  margin-right: 10rpx;
}

.log-hd {
  margin-bottom: 8rpx;
}

.log {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #faf5ee;
}

.log:last-child {
  border-bottom: none;
}

.log-amt {
  font-size: 30rpx;
  font-weight: 600;
  color: #9c8f84;
}

.log-amt.up {
  color: #6f9a6a;
}

.danger {
  text-align: center;
  font-size: 28rpx;
  color: #e4736b;
  padding: 32rpx;
}

.ver {
  text-align: center;
  padding: 16rpx 0 40rpx;
}

.invite {
  display: flex;
  align-items: center;
}

.invite-code {
  margin-left: 20rpx;
  padding: 12rpx 22rpx;
  border-radius: 18rpx;
  background: #fff5e9;
  color: #d9863c;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  white-space: nowrap;
}

.boot {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.boot-emoji {
  font-size: 72rpx;
  animation: bootPulse 1.4s ease-in-out infinite;
}

@keyframes bootPulse {
  0%, 100% { opacity: 0.45; transform: scale(0.96); }
  50% { opacity: 1; transform: scale(1); }
}

.mini-stat {
  flex-shrink: 0;
  background: #fff5e9;
  color: #d9863c;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}

/* 页面内确认框 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(60, 45, 35, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 60rpx;
}

.sheet {
  width: 100%;
  background: #fffdf8;
  border-radius: 32rpx;
  padding: 44rpx 40rpx 36rpx;
  box-shadow: 0 18rpx 60rpx rgba(90, 60, 30, 0.18);
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #4a3b2f;
  text-align: center;
  margin-bottom: 20rpx;
}

.sheet-content {
  font-size: 28rpx;
  color: #8a7a6d;
  line-height: 1.6;
  margin-bottom: 36rpx;
}

.sheet-btns {
  display: flex;
  gap: 20rpx;
}

.sheet-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: #f6ecdf;
  color: #6d5c4e;
}

.sheet-btn:active {
  transform: scale(0.97);
}

.sheet-btn.danger {
  background: #e4736b;
  color: #ffffff;
}
