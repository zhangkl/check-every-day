.profile {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-wrap:active {
  opacity: 0.85;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #ffe9d2, #ffd9ad);
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 14rpx rgba(214, 158, 92, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-emoji {
  font-size: 52rpx;
  line-height: 1;
}

.avatar-edit {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
}

/* 头像选择：emoji 全池滑动网格 + 自定义输入 */
.avatar-role {
  text-align: center;
  color: #a5988b;
  margin-bottom: 16rpx;
}

.emoji-scroll {
  max-height: 44vh;
  margin-bottom: 20rpx;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.emoji-opt {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: #fdf3e8;
  border: 4rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.emoji-opt:active {
  transform: scale(0.9);
}

.emoji-opt-t {
  font-size: 48rpx;
  line-height: 1;
}

.emoji-opt.sel {
  border-color: #f5a65b;
  background: #ffe9d2;
  box-shadow: 0 4rpx 14rpx rgba(214, 158, 92, 0.35);
}

.emoji-custom {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.emoji-input {
  flex: 1;
  margin-bottom: 0;
}

.emoji-use {
  flex-shrink: 0;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 30rpx;
  border-radius: 22rpx;
  background: #f0e6d8;
  color: #b3a594;
  font-size: 28rpx;
  font-weight: 600;
}

.emoji-use.on {
  background: linear-gradient(135deg, #f7bd7e, #f5a65b);
  color: #ffffff;
}

.profile .muted {
  margin-top: 10rpx;
  line-height: 1.5;
}

.stats {
  display: flex;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 26rpx 8rpx;
  margin: 0 8rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(200, 170, 140, 0.1);
}

.stat-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #4a4038;
}

.stat-item .tiny {
  margin-top: 8rpx;
}

.menu {
  padding: 8rpx 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #faf5ee;
}

.menu-item:last-child {
  border-bottom: none;
}

.mi-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.mi-arrow {
  color: #cfc2b4;
  font-size: 34rpx;
  margin-left: 8rpx;
}

.mi-badge {
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #e4736b;
  color: #fff;
  font-size: 22rpx;
  padding: 0 10rpx;
  margin-right: 10rpx;
}

.log-hd {
  margin-bottom: 8rpx;
}

.log {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #faf5ee;
}

.log:last-child {
  border-bottom: none;
}

.log-amt {
  font-size: 30rpx;
  font-weight: 600;
  color: #9c8f84;
}

.log-amt.up {
  color: #6f9a6a;
}

.danger {
  text-align: center;
  font-size: 28rpx;
  color: #e4736b;
  padding: 32rpx;
}

.ver {
  text-align: center;
  padding: 16rpx 0 40rpx;
}

.invite-code {
  padding: 12rpx 22rpx;
  border-radius: 18rpx;
  background: #fff5e9;
  color: #d9863c;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  white-space: nowrap;
}

/* 菜单行内的邀请码 + 邀请按钮 */
.invite-item .body {
  white-space: nowrap;
}

.invite-code.sm {
  flex-shrink: 0;
  margin-left: 0;
  padding: 6rpx 14rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.invite-code.sm:active {
  opacity: 0.75;
}

.invite-share {
  flex: 0 0 76rpx;
  width: 76rpx;
  min-width: 0;
  height: 44rpx;
  line-height: 44rpx;
  padding: 0;
  margin: 0 0 0 8rpx;
  border: none;
  background: transparent;
  color: #b3a594;
  font-size: 22rpx;
}

.invite-share::after {
  border: none;
}

.label-link {
  color: #d9863c;
}

/* 分享按压反馈（邀请按钮 hover-class 用） */
.share-btn-hover {
  opacity: 0.85;
}

.boot {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.boot-emoji {
  font-size: 72rpx;
  animation: bootPulse 1.4s ease-in-out infinite;
}

@keyframes bootPulse {
  0%, 100% { opacity: 0.45; transform: scale(0.96); }
  50% { opacity: 1; transform: scale(1); }
}

.mini-stat {
  flex-shrink: 0;
  background: #fff5e9;
  color: #d9863c;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}

/* 页面内确认框 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(60, 45, 35, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 60rpx;
}

.sheet {
  width: 100%;
  background: #fffdf8;
  border-radius: 32rpx;
  padding: 44rpx 40rpx 36rpx;
  box-shadow: 0 18rpx 60rpx rgba(90, 60, 30, 0.18);
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #4a3b2f;
  text-align: center;
  margin-bottom: 20rpx;
}

.sheet-content {
  font-size: 28rpx;
  color: #8a7a6d;
  line-height: 1.6;
  margin-bottom: 36rpx;
}

/* 称呼弹窗里的输入框：有高度有底色，和按钮拉开距离 */
.sheet-input {
  height: 84rpx;
  background: #fbf6ef;
  border-radius: 22rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #4a4038;
  margin-bottom: 28rpx;
}

.ph {
  color: #c4b6a7;
}

/* 家庭信息弹窗 */
.fam-edit {
  font-size: 24rpx;
  margin-left: 10rpx;
  opacity: 0.55;
}

.fam-label {
  color: #8a7a6d;
  margin-bottom: 8rpx;
}

.sheet-content.small {
  font-size: 24rpx;
  margin-bottom: 26rpx;
}

/* 家庭成员列表：头像 + 称呼 + 身份标签 */
.fam-members {
  background: #f8f2ea;
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
  margin-bottom: 26rpx;
}

.fam-member {
  display: flex;
  align-items: center;
  padding: 14rpx 4rpx;
}

.fam-member + .fam-member {
  border-top: 2rpx solid #efe6d8;
}

.fm-avatar {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.fm-name {
  font-size: 28rpx;
  color: #4a4038;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fm-role {
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  flex-shrink: 0;
}

.fm-role.p {
  color: #d9863c;
  background: #fdf1e3;
}

.fm-role.c {
  color: #6f9a6a;
  background: #eef5ec;
}

.sheet-btns {
  display: flex;
  gap: 20rpx;
}

.sheet-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: #f6ecdf;
  color: #6d5c4e;
}

.sheet-btn:active {
  transform: scale(0.97);
}

.sheet-btn.danger {
  background: #e4736b;
  color: #ffffff;
}
