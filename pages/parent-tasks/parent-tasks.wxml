<view class="page-plain">
  <view class="hd">
    <view class="h1">清单配置</view>
    <view class="muted">改完之后，当天就生效</view>
  </view>

  <view class="mode-tabs">
    <view class="mode-tab {{viewMode === 'all' ? 'on' : ''}}" data-mode="all" bindtap="switchMode">全部 {{modeCount.all}}</view>
    <view class="mode-tab {{viewMode === 'week' ? 'on' : ''}}" data-mode="week" bindtap="switchMode">周中·一至五 {{modeCount.week}}</view>
    <view class="mode-tab {{viewMode === 'weekend' ? 'on' : ''}}" data-mode="weekend" bindtap="switchMode">周末·六日 {{modeCount.weekend}}</view>
  </view>
  <view class="mode-hint tiny" wx:if="{{viewMode !== 'all'}}">{{viewMode === 'week' ? '这些大项在周一到周五出现' : '这些大项在周六周日出现'}}</view>

  <view class="card gt" wx:for="{{groups}}" wx:key="groupKey">
    <block wx:if="{{editingKey !== item.groupKey}}">
      <view class="gt-hd" data-key="{{item.groupKey}}" bindtap="toggleOpen">
        <view class="emoji">{{item.icon}}</view>
        <view class="grow">
          <view class="h3">{{item.title}}<text class="off" wx:if="{{!item.active}}">已停用</text></view>
          <view class="tiny">{{item.children.length}} 项 · 共 {{item.points}} 分 · {{item.repeatLabel}}</view>
        </view>
        <view class="chev">{{openKey === item.groupKey ? '▾' : '▸'}}</view>
      </view>

      <view class="gt-body" wx:if="{{openKey === item.groupKey}}">
        <block wx:for="{{item.children}}" wx:for-item="c" wx:key="id">
          <view
            class="sub"
            wx:if="{{editingChildId !== c.id}}"
            data-id="{{c.id}}"
            data-key="{{item.groupKey}}"
            bindtap="onEditChild"
          >
            <view class="grow body">
              {{c.title}}
              <text class="off" wx:if="{{c.dayLabel !== '每天'}}">{{c.dayLabel}}</text>
            </view>
            <view class="tiny">{{c.points}} 分</view>
            <view class="chev-sm">›</view>
          </view>
          <view class="child-edit" wx:else>
            <view class="h3">「{{c.title}}」哪几天出现</view>
            <view class="preset-row">
              <view class="preset" data-preset="all" bindtap="pickChildPreset">每天</view>
              <view class="preset" data-preset="week" bindtap="pickChildPreset">仅周中</view>
              <view class="preset" data-preset="weekend" bindtap="pickChildPreset">仅周末</view>
            </view>
            <view class="day-row">
              <view
                class="day {{childDays[index] ? 'on' : ''}}"
                wx:for="{{dayLabels}}"
                wx:for-item="dl"
                wx:key="*this"
                data-index="{{index}}"
                bindtap="toggleChildDay"
              >{{dl}}</view>
            </view>
            <view class="edit-actions">
              <view class="mini wide" bindtap="onCancelChildDays">取消</view>
              <view class="mini wide primary" bindtap="onSaveChildDays">保存</view>
            </view>
          </view>
        </block>
        <view class="empty-sm" wx:if="{{item.children.length === 0}}">还没有子项，先加一项</view>

        <view class="gt-actions">
          <view class="mini" data-key="{{item.groupKey}}" catchtap="onAddChild">＋ 子项</view>
          <view class="mini" data-key="{{item.groupKey}}" catchtap="onEditGroup">编辑</view>
          <view class="mini" data-key="{{item.groupKey}}" catchtap="onToggleActive">{{item.active ? '停用' : '启用'}}</view>
          <view class="mini danger" data-key="{{item.groupKey}}" catchtap="onDeleteGroup">删除</view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="edit">
        <view class="h3">编辑「{{form.title}}」</view>
        <input class="input" value="{{form.title}}" maxlength="12" bindinput="onFormTitle" />
        <view class="emoji-strip">
          <view
            class="em {{form.icon === em ? 'on' : ''}}"
            wx:for="{{emojis}}"
            wx:for-item="em"
            wx:key="*this"
            data-emoji="{{em}}"
            bindtap="pickEmoji"
          >{{em}}</view>
        </view>
        <view class="preset-row">
          <view class="preset" data-preset="all" bindtap="pickPreset">每天</view>
          <view class="preset" data-preset="week" bindtap="pickPreset">仅周中</view>
          <view class="preset" data-preset="weekend" bindtap="pickPreset">仅周末</view>
        </view>
        <view class="day-row">
          <view
            class="day {{form.days[index] ? 'on' : ''}}"
            wx:for="{{dayLabels}}"
            wx:key="*this"
            data-index="{{index}}"
            bindtap="toggleDay"
          >{{item}}</view>
        </view>
        <view class="edit-actions">
          <view class="mini wide" bindtap="onCancelEdit">取消</view>
          <view class="mini wide primary" bindtap="onSaveGroup">保存</view>
        </view>
      </view>
    </block>
  </view>

  <button class="btn btn-ghost add" bindtap="onAddGroup">＋ 新增大项</button>

  <view class="card">
    <view class="h3">只加今天</view>
    <view class="tiny">不写进模板，只影响今天的清单</view>
    <view class="extra">
      <input class="input grow" value="{{extraTitle}}" placeholder="明天带美术材料" bindinput="onExtraTitle" />
      <input class="input pts" value="{{extraPoints}}" type="number" placeholder="5" bindinput="onExtraPoints" />
      <view class="unit tiny">分</view>
    </view>
    <button class="btn btn-primary btn-sm" bindtap="onAddExtra">加进今天</button>
  </view>
</view>
