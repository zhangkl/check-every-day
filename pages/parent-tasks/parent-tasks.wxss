.hd {
  padding: 16rpx 8rpx 32rpx;
}

.hd .muted {
  margin-top: 8rpx;
}

.gt {
  padding: 8rpx 26rpx 20rpx;
}

.gt-hd {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}

.gt-hd .emoji {
  margin-right: 20rpx;
}

.off {
  font-size: 22rpx;
  color: #b0a397;
  margin-left: 12rpx;
  font-weight: 400;
}

.chev {
  color: #cfc2b4;
  font-size: 28rpx;
}

.chev-sm {
  color: #d8cbbc;
  font-size: 30rpx;
  margin-left: 12rpx;
}

.gt-body {
  border-top: 2rpx solid #f6efe6;
  padding-top: 8rpx;
}

.sub {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #faf5ee;
}

.empty-sm {
  padding: 26rpx 0;
  font-size: 26rpx;
  color: #b0a397;
}

.gt-actions {
  display: flex;
  flex-wrap: wrap;
  padding-top: 20rpx;
}

.mini {
  font-size: 26rpx;
  color: #7d6f63;
  background: #f8f2ea;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  margin: 0 16rpx 12rpx 0;
}

.mini.primary {
  background: #f5a65b;
  color: #ffffff;
}

.mini.danger {
  color: #e4736b;
  background: #fdf0ee;
}

.mini.wide {
  flex: 1;
  text-align: center;
  margin: 0 8rpx;
}

.edit .input {
  margin-top: 20rpx;
}

.input {
  height: 84rpx;
  background: #fbf6ef;
  border-radius: 22rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #4a4038;
}

.emoji-strip {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.em {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: #fbf6ef;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin: 0 12rpx 12rpx 0;
}

.em.on {
  background: #fde3c6;
  box-shadow: 0 0 0 3rpx #f5a65b inset;
}

.day-row {
  display: flex;
  margin-top: 16rpx;
}

.day {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 22rpx;
  background: #fbf6ef;
  color: #9c8f84;
  font-size: 26rpx;
  margin-right: 12rpx;
}

.day.on {
  background: #f5a65b;
  color: #ffffff;
  font-weight: 600;
}

.edit-actions {
  display: flex;
  margin-top: 28rpx;
}

.add {
  margin-bottom: 24rpx;
}

.extra {
  display: flex;
  align-items: center;
  margin: 20rpx 0 24rpx;
}

.extra .grow {
  flex: 1;
}

.pts {
  width: 120rpx;
  margin-left: 16rpx;
  text-align: center;
}

.unit {
  margin-left: 10rpx;
}
