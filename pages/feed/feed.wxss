.hd {
  margin: 8rpx 4rpx 28rpx;
}

.hd .muted {
  margin-top: 6rpx;
}

.feed-tabs {
  display: flex;
  gap: 12rpx;
  background: #f6eee0;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.feed-tab {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  color: #9a7b58;
  padding: 14rpx 0;
  border-radius: 999rpx;
  line-height: 1.4;
}

.feed-tab.on {
  background: #ffffff;
  color: #b9702d;
}

.ft-badge {
  display: inline-block;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 8rpx;
  margin-left: 8rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #f8e4cd;
  color: #b9702d;
  font-size: 19rpx;
}

.feed-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 8rpx 28rpx 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(200, 170, 140, 0.12);
}

.feed-empty {
  text-align: center;
  color: #b0a397;
  font-size: 26rpx;
  padding: 80rpx 0;
}

/* 与我相关：消息列表 */
.notice-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #faf5ee;
}

.notice-item:last-child {
  border-bottom: none;
}

.ni-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #faf3e9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
}

.ni-main {
  flex: 1;
  min-width: 0;
}

.ni-text {
  font-size: 26rpx;
  color: #4a4038;
  line-height: 1.4;
}

.notice-item.unread .ni-text {
  font-weight: 600;
}

.ni-sub {
  font-size: 21rpx;
  color: #b0a397;
  margin-top: 4rpx;
}

.ni-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #e2953f;
  flex-shrink: 0;
}

/* 全部动态：操作流水 */
.log-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.log-item + .log-item {
  border-top: 2rpx solid #f6efe6;
}

.log-main {
  flex: 1;
  min-width: 0;
}

.log-line1 {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
}

.log-who {
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.log-who.p {
  color: #d9863c;
}

.log-who.c {
  color: #6f9a6a;
}

.log-action {
  font-size: 22rpx;
  color: #9a7b58;
  background: #fbf3e8;
  border-radius: 999rpx;
  padding: 3rpx 12rpx;
  flex-shrink: 0;
  line-height: 1.5;
}

.log-note {
  font-size: 26rpx;
  color: #4a4038;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.log-when {
  font-size: 22rpx;
  color: #b0a397;
  margin-top: 4rpx;
}

.log-amount {
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.log-amount.plus {
  color: #6f9a6a;
}

.log-amount.minus {
  color: #c96f5f;
}

.log-amount.none {
  color: #cdc3b8;
  font-weight: 400;
}
