/* 贴底信息栏：日期 + 设置入口 */
.ft {
  margin-top: 8rpx;
  padding: 8rpx 8rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hd-date {
  font-size: 26rpx;
  color: #a5988b;
  font-weight: 500;
}

/* 进度卡：只讲三件事——标题、进度条、数字 */
.hero2 {
  padding: 36rpx 32rpx 30rpx;
}

.hero-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #4a4038;
  line-height: 1.3;
}

.streak-chip {
  flex-shrink: 0;
  background: #fdeef2;
  color: #d4708a;
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.bar {
  height: 14rpx;
  border-radius: 999rpx;
  background: #f3e7d9;
  overflow: hidden;
}

.bar-in {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #f7bd7e, #f5a65b);
  transition: width 0.35s ease;
}

.hero-meta {
  margin-top: 18rpx;
}

.meta-line {
  font-size: 24rpx;
  color: #a5988b;
  line-height: 1.7;
}

.meta-line.late {
  color: #d9944d;
}

/* 家长快捷入口 */
.quick {
  display: flex;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 22rpx 8rpx;
  margin-bottom: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(200, 170, 140, 0.12);
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.q-icon {
  font-size: 40rpx;
  line-height: 1;
}

.q-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7d6f63;
}

.q-badge {
  position: absolute;
  top: -8rpx;
  right: 26rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #e4736b;
  color: #fff;
  font-size: 20rpx;
  padding: 0 8rpx;
}

/* 任务卡 */
.group {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 26rpx 26rpx 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(200, 170, 140, 0.12);
}

.group-hd {
  display: flex;
  align-items: center;
  padding-bottom: 18rpx;
  border-bottom: 2rpx solid #f6efe6;
}

.group-hd .emoji {
  margin-right: 18rpx;
}

.g-badge {
  font-size: 22rpx;
  color: #b0a397;
  background: #f8f2ea;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}

.g-badge.ok {
  color: #6f9a6a;
  background: #eef5ec;
}

.items {
  padding-top: 8rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  position: relative;
  border-bottom: 2rpx solid #faf5ee;
  transition: background 0.15s ease;
}

.item:last-child {
  border-bottom: none;
}

.box {
  width: 52rpx;
  height: 52rpx;
  border-radius: 18rpx;
  border: 3rpx solid #e6d9c9;
  margin-right: 22rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  transition: all 0.18s ease;
}

.item.done .box {
  background: #8fb98b;
  border-color: #8fb98b;
  transform: scale(1.02);
}

.it-title {
  font-size: 32rpx;
  color: #4a4038;
  transition: color 0.18s ease;
}

.item.done .it-title {
  color: #a79a8d;
  text-decoration: line-through;
}

.it-points {
  font-size: 26rpx;
  color: #c0b3a6;
  flex-shrink: 0;
}

.it-points.on {
  color: #8fb98b;
  font-weight: 600;
}

/* 学生发起的临时项：待家长同意 */
.item.pending .box {
  border-color: #f5c98f;
  border-style: dashed;
}

.item.pending .it-title {
  color: #7d6f63;
}

.item.delreq .box {
  border-color: #c9bcae;
  border-style: dashed;
}

.item.delreq .it-title {
  color: #a79a8d;
}

.pending-tag.del {
  color: #8a8378;
  background: #f1ece5;
}

.text-btn {
  align-self: flex-start;
  font-size: 26rpx;
  line-height: 1;
  border: 2rpx solid #e8d9c3;
  background: #fffdf9;
  border-radius: 999rpx;
  padding: 8rpx 14rpx;
}

.text-btn:active {
  opacity: 0.6;
}

.vc-transcribing {
  margin-top: 8rpx;
  color: #b08b5e;
}

.voice-trans-btn {
  margin-top: 8rpx;
  align-self: flex-start;
  font-size: 22rpx;
  color: #b08b5e;
  border: 2rpx solid #e8d9c3;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.pending-tag {
  display: inline-block;
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #d9863c;
  background: #fff5e9;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  vertical-align: middle;
}

/* 学生「自己加一项」入口 */
.add-extra {
  text-align: center;
  font-size: 26rpx;
  color: #c0a27e;
  padding: 18rpx 0 6rpx;
}

.add-extra:active {
  opacity: 0.6;
}

/* 家长长按已完成项即可撤销，不再放常驻按钮 */

/* 自绘确认弹窗（预览环境 wx.showModal 不可用） */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(60, 45, 35, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1100;
  padding: 60rpx;
}

.sheet {
  width: 100%;
  background: #fffdf8;
  border-radius: 32rpx;
  padding: 44rpx 40rpx 36rpx;
  box-shadow: 0 18rpx 60rpx rgba(90, 60, 30, 0.18);
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #4a3b2f;
  text-align: center;
  margin-bottom: 20rpx;
}

.sheet-content {
  font-size: 28rpx;
  color: #8a7a6d;
  line-height: 1.6;
  margin-bottom: 36rpx;
}

.sheet-btns {
  display: flex;
  gap: 20rpx;
}

.sheet-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: #f6ecdf;
  color: #6d5c4e;
}

.sheet-btn:active {
  transform: scale(0.97);
}

.sheet-btn.danger {
  background: #e4736b;
  color: #ffffff;
}

.sheet-btn.primary {
  background: #f5a65b;
  color: #ffffff;
}

/* 学生加项弹窗里的输入 */
.sheet-input {
  height: 84rpx;
  background: #fbf6ef;
  border-radius: 22rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #4a4038;
  margin-bottom: 20rpx;
}

.sheet-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.sheet-row .tiny {
  flex-shrink: 0;
}

.sheet-input.pts {
  width: 160rpx;
  margin-bottom: 0;
  text-align: center;
}

.sheet-content.small {
  font-size: 24rpx;
  margin-bottom: 30rpx;
}

/* 语音文字查看弹窗 */
.text-sheet {
  width: 620rpx;
  max-width: 86vw;
}

.text-scroll {
  max-height: 52vh;
  margin: 6rpx 0 10rpx;
}

.text-body {
  font-size: 30rpx;
  line-height: 1.8;
  color: #5d5147;
  white-space: pre-wrap;
  word-break: break-all;
}

.float {
  position: absolute;
  right: 40rpx;
  top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #f5a65b;
  animation: floatUp 0.7s ease-out forwards;
  pointer-events: none;
}

@keyframes floatUp {
  0% {
    opacity: 0;
    transform: translateY(6rpx) scale(0.9);
  }
  25% {
    opacity: 1;
    transform: translateY(-4rpx) scale(1.05);
  }
  100% {
    opacity: 0;
    transform: translateY(-40rpx) scale(1);
  }
}

.tail {
  text-align: center;
  padding: 8rpx 40rpx 20rpx;
  line-height: 1.6;
}

/* 庆祝 */
.celebrate {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(74, 64, 56, 0.34);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.2s ease;
}

.cel-emoji {
  font-size: 120rpx;
  animation: pop 0.6s cubic-bezier(0.2, 1.4, 0.4, 1);
}

.cel-title {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
}

.cel-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.86);
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes pop {
  0% {
    transform: scale(0.4);
    opacity: 0;
  }
  60% {
    transform: scale(1.12);
    opacity: 1;
  }
  100% {
    transform: scale(1);
  }
}

.boot {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.boot-emoji {
  font-size: 72rpx;
  animation: bootPulse 1.4s ease-in-out infinite;
}

@keyframes bootPulse {
  0%, 100% { opacity: 0.45; transform: scale(0.96); }
  50% { opacity: 1; transform: scale(1); }
}

/* 语音小结 */
.mic-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fdeef2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
  margin-right: 18rpx;
  transition: all 0.15s ease;
}

.mic-btn:active {
  transform: scale(0.9);
}

.mic-btn.rec {
  background: #e4736b;
  color: #ffffff;
  animation: micPulse 1.1s ease-in-out infinite;
}

@keyframes micPulse {
  0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(228, 115, 107, 0.35); }
  50% { transform: scale(1.08); box-shadow: 0 0 0 14rpx rgba(228, 115, 107, 0); }
}

.voice-row {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.voice-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #fff5e9;
  color: #d9863c;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.voice-chip:active {
  transform: scale(0.96);
}

.voice-chip.playing {
  background: #e4736b;
  color: #ffffff;
}

.vc-icon {
  font-size: 20rpx;
}

.vc-hint {
  flex-shrink: 0;
}

.rec-tip {
  margin-top: 8rpx;
  color: #e4736b;
}

/* 多条语音：每行一段，家长可点赞 */
.voice-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 6rpx;
}

.like-btn {
  font-size: 24rpx;
  font-weight: 600;
  color: #d4708a;
  background: #fdeef2;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  flex-shrink: 0;
  transition: transform 0.18s ease;
}

.like-btn.pop {
  transform: scale(1.18);
}

/* 已点过赞：实心高亮，一眼看出当前状态 */
.like-btn.on {
  background: #d4708a;
  color: #ffffff;
}

.like-btn:active {
  transform: scale(0.94);
}

/* 右上角「我的」入口 */
.corner-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  opacity: 0.75;
}

.corner-btn:active {
  opacity: 1;
  transform: scale(0.94);
}
