/* 贴底信息栏：每日一句（古诗词 / 中英鸡汤），点一下换一条 */
.ft {
  margin-top: 8rpx;
  padding: 26rpx 16rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.quote-zh {
  font-size: 26rpx;
  color: #8a7d70;
  line-height: 1.6;
  text-align: center;
}

.quote-sub {
  font-size: 22rpx;
  color: #b8a99a;
  line-height: 1.5;
  text-align: center;
  font-style: italic;
}

/* 进度卡：上排 头像＋标题＋进度条，下排 整卡通栏的计数／快捷动作／得分 */
.hero2 {
  padding: 24rpx 26rpx 22rpx;
}

/* 左上角头像 + 右侧信息横排 */
.hero-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.hero-avatar {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f7e7c4;
  border: 3rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-avatar-emoji {
  font-size: 46rpx;
  line-height: 1;
}

.hero-avatar:active {
  transform: scale(0.95);
}

.hero-main {
  flex: 1;
  min-width: 0;
}

/* 左侧「标题＋进度条」一列，右侧灯泡按钮垂直居中 */
.hero-main-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.hero-main-col {
  flex: 1;
  min-width: 0;
}

.hero-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.hero-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3a2e24;
  line-height: 1.2;
  flex: 1;
  min-width: 0;
}

.hero-line .pill {
  padding: 4rpx 14rpx;
  font-size: 20rpx;
}

.streak-chip {
  flex-shrink: 0;
  background: #fdeef2;
  color: #d4708a;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: #efe5d3;
  overflow: hidden;
}

.bar-in {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #e9a24b, #eda95f);
  transition: width 0.35s ease;
}

/* 操作提示入口：右上角 34px 圆形灯泡按钮 */
.tips-btn {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fbf1dd;
  font-size: 30rpx;
  line-height: 1;
}

.tips-btn:active {
  transform: scale(0.9);
}

/* 整卡通栏底行：左右两块等宽，中间内容才能真正相对整卡居中 */
.hero-bottom {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 24rpx;
}

.hb-count {
  flex: 1 1 0;
  min-width: 0;
  font-size: 22rpx;
  color: #a99c8b;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 家长端三个按钮成组居中 */
.hb-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

/* 学生端：左右收回自适应宽度，古诗词吃满按钮空出来的位置 */
.hero-bottom.child .hb-count,
.hero-bottom.child .hb-earned {
  flex: 0 0 auto;
}

/* 只留一行诗句，不显示作者，底行不会拥挤 */
.hb-poem {
  flex: 1 1 0;
  min-width: 0;
  text-align: center;
  padding: 2rpx 0;
}

.hb-poem:active {
  transform: scale(0.98);
}

.poem-zh {
  font-size: 22rpx;
  color: #7a6a58;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hb-pill {
  flex-shrink: 0;
  height: 54rpx;
  line-height: 54rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  white-space: nowrap;
}

.hb-pill:active {
  transform: scale(0.95);
}

.hb-pill.add {
  background: #fbf1dd;
  color: #d9862f;
}

.hb-pill.adjust {
  background: #f5efe4;
  color: #8c7b67;
}

.hb-pill.logs {
  background: #f1f0e9;
  color: #7f7a68;
}

.hb-earned {
  flex: 1 1 0;
  min-width: 0;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
  color: #d9862f;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero-late {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #d9944d;
}

/* 任务卡 */
.group {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(200, 170, 140, 0.12);
}

/* 米色内胆：分段控件和内容面板共用同一底层 */
.gpanel {
  background: #f6eee0;
  border-radius: 28rpx;
  padding: 8rpx;
  overflow: hidden;
}

/* 白色内容面板：与选中片同为白色，接缝消失连成 L 形 */
.gbody {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
}

/* 选中片贴着面板左右两端时，面板对应顶角改直角，接缝完全连续 */
.gbody.flush-l {
  border-top-left-radius: 0;
}

.gbody.flush-r {
  border-top-right-radius: 0;
}

/* 大项名称罗列：一排文字，选中的橙色加粗带底部指示条 */
.gdeck {
  margin-bottom: 24rpx;
}

/* 大项分段控件：只是内胆里的一行内容，不再自带底色 */
.gtabs-scroll {
  white-space: nowrap;
  padding: 0;
}

.gtabs-scroll::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

.gtab {
  display: inline-block;
  vertical-align: top;
  padding: 14rpx 16rpx 16rpx;
  text-align: center;
  transition: background 0.18s ease;
}

.gtab-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #7a6a58;
  line-height: 1.4;
  transition: color 0.18s ease;
}

.gtab-meta {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #b3a79a;
  line-height: 1.4;
}

/* 选中片：白底、只圆上角、无投影，底边直接贴住下方白色面板 */
.gtab.on {
  background: #ffffff;
  border-radius: 20rpx 20rpx 0 0;
}

.gtab.on .gtab-name {
  color: #d9862f;
  font-weight: 700;
}

.gtab.on .gtab-meta {
  color: #c79b62;
}

/* 面板内列表头：左已得分，右还差分 */
.ghead {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 8rpx;
}

.ghead-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #d9862f;
}

.ghead-meta {
  font-size: 21rpx;
  color: #a99c8b;
}

/* 单卡切换动画：向左滑（下一个）从右淡入，向右滑（上一个）从左淡入 */
@keyframes gcardIn {
  from {
    opacity: 0;
    transform: translateX(36rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes gcardInL {
  from {
    opacity: 0;
    transform: translateX(-36rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.group.gcard {
  animation: gcardIn 0.24s ease;
}

.group.gcard.anim-l {
  animation: gcardInL 0.24s ease;
}

/* 任务卡 */

.g-badge {
  font-size: 22rpx;
  color: #b0a397;
  background: #f8f2ea;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}

.g-badge.ok {
  color: #6f9a6a;
  background: #eef5ec;
}

.items {
  padding-top: 4rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  position: relative;
  border-bottom: 2rpx solid #f4ede0;
  transition: background 0.15s ease;
}

.item:last-child {
  border-bottom: none;
}

.box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  border: 3rpx solid #dccbb2;
  margin-right: 18rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  transition: all 0.18s ease;
}

.item.done .box {
  background: #7faf88;
  border-color: #7faf88;
  transform: scale(1.02);
}

/* 标题 + 语音小按钮：短内容仍同一行；内容过多时标题或小按钮整组折到下一行 */
.it-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
  min-width: 0;
}

.it-title {
  font-size: 28rpx;
  color: #4a3b2e;
  transition: color 0.18s ease;
  flex-shrink: 1;
  min-width: 0;
  line-height: 1.35;
  white-space: normal;
  word-break: break-all;
}

.inline-chips {
  flex: 1 0 auto;
  min-width: 140rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.mini-chip {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #fff5e9;
  color: #d9863c;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
}

.mini-chip:active {
  opacity: 0.8;
}

.mini-chip.playing {
  background: #e4736b;
  color: #fff;
}

.mini-chip.like {
  background: #fdeef2;
  color: #d4708a;
}

.mini-chip.like.on {
  background: #d4708a;
  color: #fff;
}

.mini-chip.like.pop {
  transform: scale(1.18);
}

.mini-chip.icon,
.mini-chip.text {
  background: #f6f0e8;
  color: #8a7a6d;
}

.mini-chip.tip {
  background: transparent;
  color: #e4736b;
}

.mini-chip.more {
  background: #f6f0e8;
  color: #a5988b;
  padding: 6rpx 16rpx;
  font-size: 26rpx;
  line-height: 1;
}

/* 点 … 展开：每条语音一行，按钮全部可点 */
.voice-row.expanded {
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.voice-row.expanded .voice-line {
  width: 100%;
}

.item.done .it-title {
  color: #6f6153;
}

.it-points {
  font-size: 21rpx;
  line-height: 1.3;
  color: #a99c8b;
  background: #f5efe4;
  border-radius: 999rpx;
  padding: 4rpx 10rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.it-points.on {
  color: #64975f;
  background: #f1f6ef;
  font-weight: 600;
}

/* 学生发起的临时项：待家长同意 */
.item.pending .box {
  border-color: #f5c98f;
  border-style: dashed;
}

.item.pending .it-title {
  color: #7d6f63;
}

.item.delreq .box {
  border-color: #c9bcae;
  border-style: dashed;
}

.item.delreq .it-title {
  color: #a79a8d;
}

.pending-tag.del {
  color: #8a8378;
  background: #f1ece5;
}

.text-btn {
  align-self: flex-start;
  font-size: 24rpx;
  line-height: 1;
  border: 2rpx solid #e8d9c3;
  background: #fffdf9;
  border-radius: 999rpx;
  padding: 8rpx 14rpx;
  flex-shrink: 0;
}

.text-btn:active {
  opacity: 0.6;
}

.vc-transcribing {
  margin-top: 8rpx;
  color: #b08b5e;
}

.voice-trans-btn {
  margin-top: 8rpx;
  align-self: flex-start;
  font-size: 22rpx;
  color: #b08b5e;
  border: 2rpx solid #e8d9c3;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.pending-tag {
  display: inline-block;
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #d9863c;
  background: #fff5e9;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  vertical-align: middle;
}

/* 学生「自己加一项」入口 */
.add-extra {
  text-align: center;
  font-size: 23rpx;
  color: #d9862f;
  padding: 18rpx 0 6rpx;
}

.add-extra:active {
  opacity: 0.6;
}

/* 家长长按已完成项即可撤销，不再放常驻按钮 */

/* 自绘确认弹窗（预览环境 wx.showModal 不可用） */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(60, 45, 35, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1100;
  padding: 60rpx;
}

.sheet {
  width: 100%;
  background: #fffdf8;
  border-radius: 32rpx;
  padding: 44rpx 40rpx 36rpx;
  box-shadow: 0 18rpx 60rpx rgba(90, 60, 30, 0.18);
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #4a3b2f;
  text-align: center;
  margin-bottom: 20rpx;
}

.sheet-content {
  font-size: 28rpx;
  color: #8a7a6d;
  line-height: 1.6;
  margin-bottom: 36rpx;
}

.sheet-btns {
  display: flex;
  gap: 20rpx;
}

.sheet-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: #f6ecdf;
  color: #6d5c4e;
}

.sheet-btn:active {
  transform: scale(0.97);
}

.sheet-btn.danger {
  background: #e4736b;
  color: #ffffff;
}

.sheet-btn.primary {
  background: #f5a65b;
  color: #ffffff;
}

/* 消息区：无底色的一行细字，只有未读数带一点橙色 */
.notice-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 40rpx;
  padding: 4rpx 6rpx;
  margin: 0 4rpx 16rpx;
}

.nl-icon {
  flex-shrink: 0;
  font-size: 20rpx;
  opacity: 0.65;
}

.nl-text {
  flex: 1;
  min-width: 0;
  font-size: 21rpx;
  color: #b0a397;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nl-badge {
  flex-shrink: 0;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 8rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #f8e4cd;
  color: #b9702d;
  font-size: 19rpx;
}

.nl-arrow {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #c9bdb0;
}

/* 学生加项弹窗里的输入 */
.sheet-input {
  height: 84rpx;
  background: #fbf6ef;
  border-radius: 22rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #4a4038;
  margin-bottom: 20rpx;
}

.sheet-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.sheet-row .tiny {
  flex-shrink: 0;
}

.sheet-input.pts {
  width: 160rpx;
  margin-bottom: 0;
  text-align: center;
}

.sheet-content.small {
  font-size: 24rpx;
  margin-bottom: 30rpx;
}

/* 手动调分弹窗：两行短标签 */
.adjust-label {
  font-size: 24rpx;
  color: #b0a397;
  margin: 0 0 10rpx 6rpx;
}

/* 语音文字查看弹窗 */
.text-sheet {
  width: 620rpx;
  max-width: 86vw;
}

.text-scroll {
  max-height: 52vh;
  margin: 6rpx 0 10rpx;
}

.text-body {
  font-size: 30rpx;
  line-height: 1.8;
  color: #5d5147;
  white-space: pre-wrap;
  word-break: break-all;
}

.float {
  position: absolute;
  right: 40rpx;
  top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #f5a65b;
  animation: floatUp 0.7s ease-out forwards;
  pointer-events: none;
}

@keyframes floatUp {
  0% {
    opacity: 0;
    transform: translateY(6rpx) scale(0.9);
  }
  25% {
    opacity: 1;
    transform: translateY(-4rpx) scale(1.05);
  }
  100% {
    opacity: 0;
    transform: translateY(-40rpx) scale(1);
  }
}

.tail {
  text-align: center;
  padding: 8rpx 40rpx 20rpx;
  line-height: 1.6;
}

/* 操作提示弹窗 */

.tips-sheet {
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.tips-list {
  flex: 1;
  overflow-y: auto;
  margin-bottom: 30rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 14rpx 0;
}

.tip-no {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #ffe9d2;
  color: #d9863c;
  font-size: 24rpx;
  font-weight: 700;
  margin-top: 2rpx;
}

.tip-text {
  font-size: 27rpx;
  color: #5d5148;
  line-height: 1.6;
}

/* 庆祝 */
.celebrate {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(74, 64, 56, 0.34);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.2s ease;
}

.cel-emoji {
  font-size: 120rpx;
  animation: pop 0.6s cubic-bezier(0.2, 1.4, 0.4, 1);
}

/* 孩子被点赞的全屏庆祝 */
.like-cele {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(255, 244, 246, 0.94);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.2s ease;
}

.lc-heart {
  font-size: 150rpx;
  animation: heartBeat 0.9s ease infinite;
}

.lc-text {
  margin-top: 34rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #d4708a;
  text-align: center;
  padding: 0 60rpx;
  line-height: 1.6;
}

@keyframes heartBeat {
  0% { transform: scale(1); }
  30% { transform: scale(1.28); }
  60% { transform: scale(0.94); }
  100% { transform: scale(1); }
}

.cel-title {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
}

.cel-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.86);
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes pop {
  0% {
    transform: scale(0.4);
    opacity: 0;
  }
  60% {
    transform: scale(1.12);
    opacity: 1;
  }
  100% {
    transform: scale(1);
  }
}

.boot {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.boot-emoji {
  font-size: 72rpx;
  animation: bootPulse 1.4s ease-in-out infinite;
}

@keyframes bootPulse {
  0%, 100% { opacity: 0.45; transform: scale(0.96); }
  50% { opacity: 1; transform: scale(1); }
}

/* 语音小结 */
.mic-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fdeef2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
  margin-right: 18rpx;
  transition: all 0.15s ease;
}

.mic-btn:active {
  transform: scale(0.9);
}

.mic-btn.rec {
  background: #e4736b;
  color: #ffffff;
  animation: micPulse 1.1s ease-in-out infinite;
}

@keyframes micPulse {
  0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(228, 115, 107, 0.35); }
  50% { transform: scale(1.08); box-shadow: 0 0 0 14rpx rgba(228, 115, 107, 0); }
}

.voice-row {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.voice-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #fff5e9;
  color: #d9863c;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  flex-shrink: 0;
}

.voice-chip:active {
  transform: scale(0.96);
}

.voice-chip.playing {
  background: #e4736b;
  color: #ffffff;
}

.vc-icon {
  font-size: 20rpx;
}

.rec-tip {
  margin-top: 8rpx;
  color: #e4736b;
}

/* 多条语音：每行一段，家长可点赞 */
.voice-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 6rpx;
}

.like-btn {
  font-size: 24rpx;
  font-weight: 600;
  color: #d4708a;
  background: #fdeef2;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  flex-shrink: 0;
  transition: transform 0.18s ease;
}

.like-btn.pop {
  transform: scale(1.18);
}

/* 已点过赞：实心高亮，一眼看出当前状态 */
.like-btn.on {
  background: #d4708a;
  color: #ffffff;
}

.like-btn:active {
  transform: scale(0.94);
}

/* 家长点赞按钮：双端可见（学生端只读展示），点击仅家长生效 */

/* 语音评论 */
.comment-btn {
  margin-left: 4rpx;
}

.comment-sheet {
  width: 92vw;
}

.comment-scroll {
  max-height: 46vh;
  min-height: 120rpx;
}

.comment-empty {
  text-align: center;
  font-size: 24rpx;
  color: #a5988b;
  padding: 40rpx 0;
}

.comment-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fdf3e8;
  border: 3rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(214, 158, 92, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.comment-main {
  flex: 1;
  min-width: 0;
}

.comment-hd {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.comment-who {
  font-size: 22rpx;
  line-height: 1.4;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
}

.comment-who.p {
  background: #ffe3d0;
  color: #b06a2c;
}

.comment-who.c {
  background: #d8ecd2;
  color: #3d7a45;
}

.comment-when {
  font-size: 22rpx;
  color: #b8a99a;
}

.comment-text {
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #4a4038;
  word-break: break-all;
  white-space: pre-wrap;
}

.comment-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3e7d9;
}

.comment-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  background: #faf5ee;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.comment-send {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  background: #f3e7d9;
  color: #b8a99a;
  font-size: 28rpx;
  font-weight: 600;
}

.comment-send.on {
  background: linear-gradient(135deg, #f7bd7e, #f5a65b);
  color: #fff;
}

.comment-send:active {
  transform: scale(0.96);
}

/* 家庭留言板：顶部预览行 + 弹窗列表 */
/* 待处理提醒：只在有兑换/心愿待审批时出现 */
.approve-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff3e2;
  border: 2rpx solid #f6dfbe;
  border-radius: 24rpx;
  padding: 18rpx 26rpx;
  margin: 8rpx 0 4rpx;
}

.approve-tip:active {
  opacity: 0.85;
}

.at-icon {
  font-size: 28rpx;
}

.at-text {
  flex: 1;
  font-size: 26rpx;
  color: #b9793a;
}

.at-arrow {
  font-size: 34rpx;
  color: #d3a878;
}

.note-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx 26rpx;
  margin: 8rpx 0 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(120, 90, 50, 0.08);
}

.note-banner:active {
  transform: scale(0.985);
}

/* 空态横幅：全新独立样式，显式锁高，不依赖旧规则 */
.note-slim {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 12rpx 26rpx;
  margin: 8rpx 0 26rpx;
  height: 104rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(120, 90, 50, 0.08);
}

.note-slim:active {
  transform: scale(0.985);
}

.note-slim .ns-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f6eddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

.note-slim .ns-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #a18f7c;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.note-slim .ns-plus {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #eda95f;
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.nb-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #fdf3e8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

.nb-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #4a4038;
  line-height: 1.5;
}

.nb-clip {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}

.nb-count {
  flex-shrink: 0;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #f5a65b;
  color: #fff;
  font-size: 22rpx;
  padding: 0 8rpx;
}

.nb-plus {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #eda95f;
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.note-sheet {
  width: 92vw;
}

.note-scroll {
  max-height: 52vh;
  min-height: 140rpx;
}

/* 空留言板：不让固定最小高度撑出一大片留白，弹窗随内容收矮 */
/* 空留言板：没有内容列表，去掉分割线、拉开呼吸感，弹窗随内容收矮 */
.note-sheet.empty {
  padding-top: 30rpx;
  padding-bottom: 30rpx;
}

.note-sheet.empty .sheet-title {
  margin-bottom: 6rpx;
}

.note-sheet.empty .note-scroll {
  min-height: 0;
}

.note-sheet.empty .comment-empty {
  padding: 20rpx 0 28rpx;
}

.note-sheet.empty .comment-input-row {
  padding-top: 0;
  border-top: none;
}

.note-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  align-items: flex-start;
}

.note-pin-tag {
  font-size: 22rpx;
  line-height: 1.4;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #fff2d9;
  color: #b06a2c;
}

.note-ops {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
}

.note-op {
  font-size: 28rpx;
  opacity: 0.55;
  padding: 4rpx 6rpx;
}

.note-op:active {
  opacity: 1;
  transform: scale(1.15);
}
