.brand {
  padding: 50rpx 8rpx 32rpx;
  text-align: center;
}

.brand.compact {
  padding: 40rpx 8rpx 28rpx;
}

.logo {
  font-size: 56rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}

.brand.compact .logo {
  font-size: 52rpx;
  margin-bottom: 12rpx;
}

.brand .h1 {
  font-size: 40rpx;
  margin-bottom: 0;
}

.brand.compact .h1 {
  font-size: 36rpx;
}

/* 标题与副标签分行居中 */
.title-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.title-row .h1 {
  margin-bottom: 0;
}

.brand-tag {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: #d9863c;
  background: #fff5e9;
  border-radius: 999rpx;
  padding: 6rpx 22rpx;
}

.tabs {
  display: flex;
  background: #f6efe6;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 28rpx;
  color: #9c8f84;
  border-radius: 999rpx;
}

.tab.on {
  background: #ffffff;
  color: #4a4038;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(200, 170, 140, 0.16);
}

.field {
  margin-top: 28rpx;
}

.label {
  font-size: 26rpx;
  color: #9c8f84;
  margin-bottom: 12rpx;
}

.input {
  height: 92rpx;
  background: #fbf6ef;
  border-radius: 24rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
  color: #4a4038;
}

.input.code {
  letter-spacing: 8rpx;
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
}

.ph {
  color: #c8bcb0;
  letter-spacing: 0;
  font-weight: 400;
}

.note {
  margin-top: 24rpx;
  line-height: 1.7;
}

.err {
  margin-top: 8rpx;
  padding: 20rpx 24rpx;
  background: #fdeef2;
  color: #c56279;
  border-radius: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.done-card {
  margin-top: 12rpx;
}

.code-box {
  margin: 32rpx 0 12rpx;
  height: 140rpx;
  line-height: 140rpx;
  text-align: center;
  background: #fff5e9;
  border-radius: 28rpx;
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  color: #d9863c;
}

.center {
  text-align: center;
}

.wide {
  margin-top: 32rpx;
  width: 100%;
}

.foot {
  margin-top: 40rpx;
  text-align: center;
  line-height: 1.7;
  padding: 0 32rpx;
}
